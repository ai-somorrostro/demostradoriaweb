---
import BaseLayout from "../layouts/BaseLayout.astro";
---

<BaseLayout title="Hardware" description="Hardware de MEC">
  <div class="max-w-4xl mx-auto px-4 py-16">
    <h1 class="text-4xl font-bold text-gray-900 mb-6">Hardware</h1>
    <p class="text-lg text-gray-600 max-w-2xl mb-12">
      Información sobre el hardware que utilizamos. Especificaciones técnicas,
      equipamiento y configuraciones.
    </p>

    <div class="prose prose-gray max-w-none">
      <h2>Equipamiento</h2>
      <p>Placeholder para el listado de equipamiento.</p>

      <h2>Especificaciones técnicas</h2>
      <p>Placeholder para las especificaciones técnicas.</p>

      <h2>Configuraciones</h2>
      <p>Placeholder para las configuraciones disponibles.</p>
    </div>
  </div>
</BaseLayout>
