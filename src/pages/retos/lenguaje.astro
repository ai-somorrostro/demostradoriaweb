---
import BaseLayout from "../../layouts/BaseLayout.astro";
import { url } from "../../utils/url";

const proyectos = [
  {
    nombre: "NewsAI Studio",
    repo: "https://github.com/ai-somorrostro/g2r12025modelo",
    desc: "Consulta y análisis de noticias en tiempo real mediante RAG. Búsqueda vectorial + texto completo sobre Elasticsearch, con corrección de consultas y persistencia de conversaciones.",
  },
  {
    nombre: "JobMatcher AI",
    repo: "https://github.com/ai-somorrostro/g3r1devops",
    desc: "Recomendador de empleo con IA generativa. Microservicios, ELK Stack, FastAPI y React. El usuario describe su perfil y el sistema cruza habilidades, salario y ubicación contra ofertas reales.",
  },
  {
    nombre: "CineBot",
    repo: "https://github.com/ai-somorrostro/g4r12025pia",
    desc: "RAG híbrido sobre datos de películas. Enruta preguntas entre búsqueda de diálogos, semántica de tramas y datos estructurados. Scraping de TMDB, Elasticsearch y pipeline Logstash.",
  },
];
---

<BaseLayout title="Reto – Lenguaje" description="Reto de Modelos de Lenguaje">
  <div class="max-w-4xl mx-auto px-4 py-16">
    <nav class="text-sm text-gray-500 mb-8">
      <a href={url("/retos")} class="hover:text-gray-900 transition-colors">Retos</a>
      <span class="mx-2">›</span>
      <span class="text-gray-900">Lenguaje</span>
    </nav>

    <h1 class="text-4xl font-bold text-gray-900 mb-4">Modelos de Lenguaje</h1>
    <p class="text-lg text-gray-600 mb-4">
      ¿Cómo convertir grandes volúmenes de información en respuestas útiles para
      cualquier persona? Ese fue el reto: ingesta automatizada, Elasticsearch,
      RAG y modelos de lenguaje conectados a datos reales.
    </p>
    <p class="text-gray-500 mb-10">
      Tres equipos de 4 alumnos, tres casos de uso distintos, misma arquitectura
      de fondo.
    </p>

    <div class="space-y-4 mb-14">
      {
        proyectos.map(({ nombre, repo, desc }) => (
          <div class="border border-gray-200 rounded-lg p-6 hover:border-gray-400 transition-colors">
            <div class="flex items-start justify-between gap-4 mb-2">
              <h2 class="font-semibold text-gray-900 text-lg">{nombre}</h2>
              <a
                href={repo}
                target="_blank"
                rel="noopener noreferrer"
                class="shrink-0 text-xs text-gray-400 hover:text-gray-700 border border-gray-200 px-2 py-1 rounded transition-colors"
              >
                GitHub →
              </a>
            </div>
            <p class="text-gray-600 text-sm">{desc}</p>
          </div>
        ))
      }
    </div>

    <div>
      <div class="flex items-center justify-between mb-3">
        <h2 class="font-semibold text-gray-900">Enunciado del reto</h2>
        <a
          href="https://github.com/ai-somorrostro/retosdemostradoria"
          target="_blank"
          rel="noopener noreferrer"
          class="text-xs text-gray-400 hover:text-gray-700 border border-gray-200 px-2 py-1 rounded transition-colors"
        >
          Repo completo →
        </a>
      </div>
      <iframe
        src={url("/docs/RetoModelosLenguaje.pdf")}
        class="w-full h-[600px] rounded-lg border border-gray-200"
        title="Enunciado Reto Modelos de Lenguaje"
      />
      <p class="text-xs text-gray-400 mt-2">
        <a
          href={url("/docs/RetoModelosLenguaje.pdf")}
          target="_blank"
          rel="noopener noreferrer"
          class="underline hover:text-gray-700"
        >
          Abrir PDF en nueva pestaña
        </a>
      </p>
    </div>
  </div>
</BaseLayout>
