---
import { url } from "../utils/url";
const year = new Date().getFullYear();
---

<footer class="border-t border-gray-200 mt-auto">
  <div class="max-w-6xl mx-auto px-4 py-8 flex flex-col sm:flex-row justify-between items-center gap-4 text-sm text-gray-500">
    <p>© {year} MEC. Todos los derechos reservados.</p>
    <nav class="flex gap-4">
      <a href={url("/noticias")} class="hover:text-gray-900 transition-colors">Noticias</a>
      <a href={url("/servicios")} class="hover:text-gray-900 transition-colors">Servicios</a>
    </nav>
  </div>
</footer>
